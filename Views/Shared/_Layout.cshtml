﻿<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrimeiroProjetoMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PrimeiroProjetoMVC.styles.css" asp-append-version="true" />
</head>

<body>
    <nav>
        <a asp-controller="Home" asp-action="Index">Início</a>
        <a asp-controller="Home" asp-action="Sobre">Sobre</a>
        <a asp-controller="Home" asp-action="Saudacao">Saudação</a>
        <a asp-controller="Eventos" asp-action="Index">Lista de eventos</a>
        <a asp-controller="Eventos" asp-action="Criar">Cadastrar evento</a>
    </nav>
    <hr />

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>